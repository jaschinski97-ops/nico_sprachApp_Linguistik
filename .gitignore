# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local generator drafts and temporary verification builds (never shipped)
/.content-studio/
/build-verification/

# Lokale Ablage — alles, was nie auf GitHub soll, heißt *_Local
/_Local/
/.agent/
/.claude/
*_Local/
*_Local.*

# Playwright-Automationsartefakte (Snapshots, Konsolenlogs) — nur lokal
/.playwright-mcp/

# Generierte Mess-/Pruefberichte (bis 183 MB, jederzeit regenerierbar) —
# Protokolle in pipeline/logs/ bleiben bewusst im Repo.
/pipeline/reports/
